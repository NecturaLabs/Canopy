#!/usr/bin/env bash
# Git pre-commit hook: refuses a commit while clippy, with warnings denied as in CI, finds
# anything or a workspace test fails (CI's test jobs are off unless CI_TESTS=1, so this is where
# the tests gate). Skipped when the commit stages no Rust source or build configuration.
# Install with tools/install-hooks.sh.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged=$(mktemp "${TMPDIR:-/tmp}/canopy-staged.XXXXXX")
trap 'rm -f -- "$staged"' EXIT
git diff --cached --name-only -z --diff-filter=ACMRD >"$staged"
rust_changed=false
while IFS= read -r -d '' path; do
    case "$path" in
        *.rs | Cargo.toml | */Cargo.toml | Cargo.lock | */Cargo.lock | \
        clippy.toml | */clippy.toml | rust-toolchain.toml | */rust-toolchain.toml)
            rust_changed=true
            ;;
    esac
done <"$staged"
if ! "$rust_changed"; then
    exit 0
fi

# Git exports repository context to hooks. The tests create their own repositories; keeping
# GIT_DIR or GIT_INDEX_FILE would make their git commands modify this checkout instead.
git_context=$(git rev-parse --local-env-vars)
while IFS= read -r variable; do
    unset "$variable"
done <<<"$git_context"

echo "pre-commit: cargo clippy --workspace --all-targets --locked -- -D warnings" >&2
if ! cargo clippy --workspace --all-targets --locked -- -D warnings; then
    echo "pre-commit: clippy found problems; fix them and commit again." >&2
    exit 1
fi

echo "pre-commit: cargo test --workspace --locked" >&2
test_gitconfig=$(mktemp "${TMPDIR:-/tmp}/canopy-hook-gitconfig.XXXXXX")
trap 'rm -f -- "$staged" "$test_gitconfig"' EXIT
git config --file "$test_gitconfig" user.name "Canopy CI"
git config --file "$test_gitconfig" user.email "ci@canopy.invalid"
git config --file "$test_gitconfig" init.defaultBranch main
if ! GIT_CONFIG_GLOBAL="$test_gitconfig" GIT_CONFIG_NOSYSTEM=1 cargo test --workspace --locked; then
    echo "pre-commit: a test failed; fix it and commit again." >&2
    exit 1
fi
