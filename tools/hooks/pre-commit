#!/usr/bin/env bash
# Git pre-commit hook: refuses a commit while clippy, with warnings denied as in CI, finds
# anything. Skipped when the commit stages no Rust source or build configuration.
# Install with tools/install-hooks.sh. Bypass with `git commit --no-verify` only when told to.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only --diff-filter=ACMRD |
    grep -Eq '(\.rs|(^|/)Cargo\.(toml|lock)|(^|/)clippy\.toml|(^|/)rust-toolchain\.toml)$'; then
    exit 0
fi

echo "pre-commit: cargo clippy --workspace --all-targets --locked -- -D warnings" >&2
if ! cargo clippy --workspace --all-targets --locked -- -D warnings; then
    echo "pre-commit: clippy found problems; fix them and commit again." >&2
    exit 1
fi
